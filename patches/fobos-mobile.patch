+    private void DumpArrangeDebugInfo(Vector2 viewport, float scale)
+    {
+        try
+        {
+            var dir = ProgramShared.PathOffset;
+            if (string.IsNullOrEmpty(dir))
+                return;
+            var sb = new System.Text.StringBuilder();
+            sb.AppendLine($"utc={DateTime.UtcNow:O}");
+            sb.AppendLine($"viewport={viewport} controls_scale={scale.ToString(CultureInfo.InvariantCulture)}");
+            sb.AppendLine($"stick pos={_thumbstick.GlobalPosition} size={_thumbstick.Size} custom={_thumbstick.CustomPosition?.ToString() ?? "<none>"}");
+            foreach (var b in _allButtons)
+            {
+                sb.AppendLine($"btn {b.Id} pos={b.GlobalPosition} size={b.Size} custom={b.CustomPosition?.ToString() ?? "<none>"} label=\"{b.Text}\" edit={b.IsEditMode}");
+            }
+            File.WriteAllText(Path.Combine(dir, "mobile-arrange-debug.txt"), sb.ToString());
+        }
+        catch { }
+    }
