+
+    protected internal override void MouseMove(GUIMouseMoveEventArgs args)
+    {
+        base.MouseMove(args);
+
+        if (IsEditMode && _currentlyDraggingControl != null && _dragTouchOffset != null)
+        {
+            var delta = args.GlobalPosition - _dragStartPos;
+            if (delta.LengthSquared() > 16f)
+            {
+                _hasDraggedCurrent = true;
+            }
+
+            var parentGlobal = _clusterContainer.GlobalPosition;
+            var newGlobal = args.GlobalPosition - _dragTouchOffset.Value;
+            var newLocal = newGlobal - parentGlobal;
+
+            if (_currentlyDraggingControl is PojavActionButton btn)
+            {
+                btn.CustomPosition = newLocal;
+                btn.Arrange(new UIBox2(newLocal, newLocal + btn.Size));
+            }
+            else if (_currentlyDraggingControl is VirtualThumbstick stick)
+            {
+                stick.CustomPosition = newLocal;
+                stick.Arrange(new UIBox2(newLocal, newLocal + stick.Size));
+            }
+
+            SaveLayout();
+        }
+    }
+
+    protected internal override void KeyBindUp(GUIBoundKeyEventArgs args)
+    {
+        base.KeyBindUp(args);
+
+        if (args.Function == EngineKeyFunctions.UIClick)
+        {
+            if (IsEditMode && _currentlyDraggingControl != null)
+            {
+                var dragged = _currentlyDraggingControl;
+                var wasDragged = _hasDraggedCurrent;
+                _currentlyDraggingControl = null;
+                _dragTouchOffset = null;
+                SaveLayout();
+                InvalidateArrange();
+
+                if (!wasDragged && dragged is PojavActionButton btn)
+                {
+                    OpenConfigureButtonDialog(btn);
+                }
+                args.Handle();
+                return;
+            }
+        }
+    }
